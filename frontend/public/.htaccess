Options -MultiViews
RewriteEngine On
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ index.html [QSA,L]

# Arquivos com nome fixo (index.html, assets/index.js, assets/index.css): o navegador
# revalida a cada visita (304 se não mudou) para atualizações chegarem na hora
<IfModule mod_headers.c>
    <FilesMatch "^index\.(html|js|css)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>
